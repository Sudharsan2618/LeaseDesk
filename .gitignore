# ─────────────────────────────────────────────────────────────
# Monorepo .gitignore — BE (FastAPI/Python) + FD (Next.js)
# Patterns are unanchored so they apply in every sub-package.
# ─────────────────────────────────────────────────────────────

# ── Secrets / environment ──
.env
.env.*
!.env.example
!.env.local.example
*.pem
*.key

# ── Node / Next.js (FD) ──
node_modules/
.next/
out/
build/
dist/
.vercel/
coverage/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Python (BE) ──
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
.eggs/
# virtual environments
.venv/
venv/
env/
ENV/

# ── Build / IaC scratch (Render, Docker) ──
*.log

# ── OS / editor ──
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# ── Claude / tooling local state ──
.claude/settings.local.json
